# Single source of truth for every service in docker/docker-compose.yml.
# Each service loads this via `env_file: ../.env`. Every credential is defined
# exactly ONCE here. shared/config.py assembles DATABASE_URL,
# and the S3 credentials from these primitives. Connection HOSTS
# are not stored here: config defaults them to localhost (host-side dev), and the
# api/worker services override them to the compose service names.

# --- Postgres: initializes the postgres service; backs DATABASE_URL/_auth/_test ---
POSTGRES_USER=roadbuilders
POSTGRES_PASSWORD=roadbuilders
POSTGRES_DB=roadbuilders

# --- MinIO: initializes the minio service; backs S3_ACCESS_KEY / S3_SECRET_KEY ---
MINIO_ROOT_USER=roadbuilders
MINIO_ROOT_PASSWORD=roadbuilders

# --- Object storage bucket ---
S3_BUCKET=roadbuilders

# --- Application secrets (api/worker) ---
OPENROUTER_API_KEY=<your_openrouter_api_key_here>
ANTHROPIC_API_KEY=<your_anthropic_api_key_here>
JWT_SECRET=<generate_a_random_secret>

# --- Miscellaneous ---
CROSS_ENCODER_MODEL=cohere/rerank-v3.5
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=512
OPENROUTER_API_URL_CHAT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_URL_RERANK=https://openrouter.ai/api/v1/rerank
OPENROUTER_API_URL_EMBEDDING=https://openrouter.ai/api/v1/embeddings
MULTI_QUERY_MODEL=anthropic/claude-sonnet-4.6
MULTI_QUERY_N=5
RETRIEVER_CANDIDATE_K=50
RETRIEVER_TOP_K=10
GOOGLE_STATIC_MAPS_API_KEY=<your_google_static_maps_api_key_here>